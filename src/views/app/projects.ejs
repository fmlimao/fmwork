<%- contentFor('body') %>

<!-- Content Header (Page header) -->
<section class="content-header">
  <h1>
    <i class="fa fa-sitemap"></i> Projetos
  </h1>
  <ol class="breadcrumb">
    <li><a href="/app"><i class="fa fa-home"></i> Início</a></li>
    <li class="active"><i class="fa fa-sitemap"></i> Projetos</li>
  </ol>
</section>

<!-- Main content -->
<section class="content">

  <!-- Formulario de criaçao e ediçao de projetos (temporario, depois vai para uma modal) -->
  <div class="box">
    <div class="box-header">
      <h3 class="box-title" v-if="!tenant.fields.uuid.value"><%- __('Criar Projeto') %></h3>
      <h3 class="box-title" v-else><%- __('Editar Projeto') %></h3>
    </div>
    <div class="box-body">
      <form @submit.prevent="App.saveTenant()">

        <div class="alert" v-if="tenant.messages.length" :class="{'alert-danger': tenant.error, 'alert-success': !tenant.error}">
          <p v-for="message in tenant.messages">{{ message }}</p>
        </div>

        <input type="text" name="uuid" v-model="tenant.fields.uuid.value">

        <div class="form-group">
          <label for="name"><%- __('Nome') %></label>
          <input type="text" class="form-control" v-model="tenant.fields.name.value">
        </div>

        <div class="form-group">
          <label for="description"><%- __('Descrição') %></label>
          <textarea name="description" id="description" class="form-control" rows="3" v-model="tenant.fields.description.value"></textarea>
        </div>

        <div class="form-group">
          <label for="appTitle"><%- __('Título') %></label>
          <input type="text" class="form-control" v-model="tenant.fields.appTitle.value">
        </div>

        <div class="form-group">
          <label for="appShortTitle"><%- __('Título curto') %></label>
          <input type="text" class="form-control" v-model="tenant.fields.appShortTitle.value">
        </div>

        <div class="form-group">
          <label for="active"><%- __('Ativo') %></label>
          <select name="active" id="active" class="form-control" v-model="tenant.fields.active.value">
            <option value="1"><%- __('Ativo') %></option>
            <option value="0"><%- __('Inativo') %></option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary" v-if="!tenant.fields.uuid.value">
          <span class="fa fa-save"></span>
          <%- __('Criar') %>
        </button>

        <button type="submit" class="btn btn-primary" v-else>
          <span class="fa fa-save"></span>
          <%- __('Atualizar') %>
        </button>

        <button type="button" class="btn btn-default" @click="App.cancelTenant()">
          <span class="fa fa-times"></span>
          <%- __('Cancelar') %>
        </button>
      </form>
    </div>
  </div>

  <div class="box">
    <div class="box-header">
      <h3 class="box-title">Lista de Projetos</h3>
    </div>
    <datatables :model="tenants"></datatables>
  </div>

</section>
<!-- /.content -->

<%- contentFor('scripts') %>

<script>
  mixins.push({
    data: {
      tenants: {
        loading: false,
        loaded: false,
        list: [],
        // title: 'Lista de Projetos',
        // buttons: [
        //   {
        //     label: '<span class="fa fa-plus"></span>',
        //     class: 'btn btn-outline-warning btn-sm btn-flat',
        //     click: () => App.openNewProjectModal()
        //   }
        // ],
        meta: {
          totalCount: 0,
          filteredCount: 0,
          start: 0,
          length: 10,
          pages: 0,
          currentPage: 0,
          orderBy: {
            column: 'name',
            dir: "ASC"
          }
        },
        initialOptions: {
          start: 0,
          length: 10,
          orderByColumn: 'name',
          orderByDir: 'ASC',
        },
        columns: [
          {
            label: "<%- __('Nome')%>",
            field: 'name',
            minWidth: 200,
            sortable: true,
            html: true,
            render: (value, row) => {
              return `
                <a href="#" onclick="App.projectSelect(event, '${row.uuid}');">
                  ${row.name}
                </a>
              `
            }
          },
          {
            label: "<%- __('Descrição')%>",
            field: 'description',
            sortable: false,
          },
          {
            label: "<%- __('Título')%>",
            field: 'appTitle',
            sortable: false,
            width: 200,
          },
          {
            label: "<%- __('Título curto')%>",
            field: 'appShortTitle',
            sortable: false,
            width: 200,
          },
          {
            label: "<%- __('Criado em')%>",
            field: 'createdAt',
            sortable: true,
            width: 200,
            align: 'center',
            nowrap: true,
            html: true,
            render: (value, row) => {
              return datimeFormatDefault(row.createdAt, 'DD/MM/YYYY HH:mm:ss')
            }
          },
          {
            label: "<%- __('Ativo')%>",
            field: 'active',
            sortable: true,
            width: 100,
            align: 'center',
            nowrap: true,
            html: true,
            render: (value, row) => {
              return row.active
                ? "<span class='label label-success'><%- __('Ativo') %></span>"
                : "<span class='label label-danger'><%- __('Inativo') %></span>"
            }
          },
          // {
          //   label: 'Ações',
          //   sortable: false,
          //   width: 120,
          //   nowrap: true,
          //   html: true,
          //   buttons: [
          //     {
          //       label: '<span class="fa fa-pencil"></span>',
          //       class: 'btn btn-outline-default btn-sm btn-flat',
          //       click: (row) => window.location.href = `/app/clients/${row._id}`
          //     },
          //     {
          //       label: '<span class="fa fa-trash"></span>',
          //       class: 'btn btn-outline-danger btn-sm btn-flat',
          //       click: (row) => App.deleteClient(row._id)
          //     }
          //   ]
          // },
        ],
        getList: () => {
          App.getTenants()
        },
      },

      tenant: {
        loading: true,
        error: true,
        messages: [
          'teste 1',
          'teste 2',
          'teste 3',
          'teste 4',
          'teste 5',
          'teste 6',
          'teste 7',
        ],
        fields: {
          uuid: {
            error: true,
            messages: ['uuid error'],
            value: 'uuid'
          },
          name: {
            error: true,
            messages: ['name error'],
            value: 'name'
          },
          description: {
            error: true,
            messages: ['description error'],
            value: 'description'
          },
          appTitle: {
            error: true,
            messages: ['appTitle error'],
            value: 'appTitle'
          },
          appShortTitle: {
            error: true,
            messages: ['appShortTitle error'],
            value: 'appShortTitle'
          },
          active: {
            error: true,
            messages: ['active error'],
            value: '1'
          },

        }
      }

    },
    methods: {
      init: () => {
        App.getTenants()
      },

      getTenants: async () => {
        doLog('getTenants()')

        try {
          const options = Object.assign(App.tenants.initialOptions)

          App.tenants.loading = true

          const response = (await axios({
            method: 'get',
            url: '/api/v1/tenants',
            params: options,
          })).data

          App.tenants.meta = response.content.meta
          App.tenants.list = response.content.data

          App.tenants.loading = false
          App.tenants.loaded = true
        } catch (error) {
          doLog("getTenants() error", error)
          notify('Ocorreu um erro interno. Por favor tenta novamente', 'danger')
        }

      },

      projectSelect: (event, uuid) => {
        event.preventDefault()
        console.log('projectSelect()', uuid)

        // Vamos buscar o projeto
        const project = App.tenants.list.find(project => project.uuid === uuid)
        console.log('projectSelect()', project)

        // Vamos preencher o formulario
        $('#name').val(project.name)
        $('#description').val(project.description)
        $('#appTitle').val(project.appTitle)
        $('#appShortTitle').val(project.appShortTitle)
        $('#active').val(project.active)
        $('#uuid').val(project.uuid)

        // Vamos abrir o modal
        // $('#projectModal').modal('show')
      },
    }
  })
</script>