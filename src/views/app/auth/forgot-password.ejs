<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title><%- pageTitle %> - Esqueci a Senha</title>
  <!-- Tell the browser to be responsive to screen width -->
  <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
  <!-- Bootstrap 3.3.7 -->
  <link rel="stylesheet" href="/assets/app/bower_components/bootstrap/dist/css/bootstrap.min.css">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="/assets/app/bower_components/font-awesome/css/font-awesome.min.css">
  <!-- Ionicons -->
  <link rel="stylesheet" href="/assets/app/bower_components/Ionicons/css/ionicons.min.css">
  <!-- Theme style -->
  <link rel="stylesheet" href="/assets/app/bower_components/admin-lte/dist/css/AdminLTE.min.css">
  <!-- iCheck -->
  <link rel="stylesheet" href="/assets/app/bower_components/admin-lte/plugins/iCheck/square/blue.css">

  <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
  <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
  <!--[if lt IE 9]>
  <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
  <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
  <![endif]-->

  <!-- Google Font -->
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic">
</head>

<body class="hold-transition login-page">
  <div class="login-box" id="AppVue">
    <div class="login-logo">
      <a href="/app"><b><%- pageTitle %></b></a>
    </div>
    <!-- /.login-logo -->
    <div class="login-box-body">
      <p class="login-box-msg">Informe seu e-mail para recuperar a sua senha.</p>

      <form @submit.prevent="doRecoverPassword()">
        <div class="alert" v-if="form.messages.length" :class="{
          'alert-danger': form.error,
          'alert-success': !form.error
        }" v-html="form.messages.join('<br>')"></div>

        <div class="form-group has-feedback" :class="{
          'has-error': form.form.email.error
        }">
          <input type="email" class="form-control" placeholder="E-mail" v-model="form.form.email.value"
            :disabled="form.loading">
          <span class="glyphicon glyphicon-envelope form-control-feedback"></span>
          <small class="help-block" v-html="form.form.email.messages.join('<br>')"></small>
        </div>

        <div class="row">
          <div class="col-xs-4">
            <button type="submit" class="btn btn-primary btn-block btn-flat" :disabled="form.loading">
              <span v-if="!form.loading">Enviar</span>
              <span v-if="form.loading">Enviando...</span>
            </button>
          </div>
          <div class="col-xs-8 text-right" style="padding-top: 6px;">
            <a href="/app/login">Voltar</a>
          </div>
          <!-- /.col -->
        </div>
      </form>

    </div>
    <!-- /.login-box-body -->

  </div>
  <!-- /.login-box -->

  <!-- jQuery 3 -->
  <script src="/assets/app/bower_components/jquery/dist/jquery.min.js"></script>
  <!-- Bootstrap 3.3.7 -->
  <script src="/assets/app/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
  <!-- iCheck -->
  <script src="/assets/app/bower_components/admin-lte/plugins/iCheck/icheck.min.js"></script>
  <!-- Vuejs CDN -->
  <script src="https://cdn.jsdelivr.net/npm/vue@2.7.14/dist/vue.min.js"></script>
  <!-- Axios CDN -->
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script>
    function isJsonDefault(str) {
      return typeof str === 'object' && typeof str.code !== 'undefined'
    }

    async function doRecoverPassword(email) {
      const response = {
        error: false,
        messages: [],
      }

      return response
    }

    var App = new Vue({
      el: '#AppVue',
      data: {
        form: {
          loading: false,
          error: false,
          messages: [],
          form: {
            email: {
              value: '',
              error: false,
              messages: [],
            },
          }
        }
      },
      methods: {
        doRecoverPassword: async () => {
          App.form.error = false
          App.form.messages = []

          App.form.form.email.value = App.form.form.email.value.trim()
          App.form.form.email.error = false
          App.form.form.email.messages = []

          if (!App.form.form.email.value) {
            App.form.error = true
            App.form.form.email.error = true
            App.form.form.email.messages.push('O campo e-mail é obrigatório.')
          }

          if (App.form.error) {
            App.form.messages.push('Verifique todos os campos.')
            return
          }

          App.form.loading = true

          try {
            const response = await doRecoverPassword(App.form.form.email.value)

            if (response.error) {
              App.form.error = response.error
              App.form.messages = response.messages || []
              App.form.loading = false
            } else {
              App.form.messages = ['Um e-mail foi enviado para o endereço informado com instruções para recuperar sua senha.']
            }

            setTimeout(() => {
              window.location.href = '/app/login'
            }, 1000)
          } catch (error) {
            console.error('Erro ao fazer login:', error)

            App.form.error = true
            App.form.messages.push('Ocorreu um erro ao tentar fazer login. Tente novamente mais tarde.')

            if (isJsonDefault(error)) {
              App.form.messages.push(error.message || 'Erro desconhecido.')
            } else {
              App.form.messages.push('Erro desconhecido.')
            }
          }
          App.form.loading = false
        }
      }
    })

    setTimeout(() => {
      App.form.form.email.value = 'admin@projetosfm.com.br'
      // App.doRecoverPassword()
    }, 500)
  </script>
</body>

</html>