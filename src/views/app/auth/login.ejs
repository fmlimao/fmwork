<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title><%- pageTitle %> - Login</title>
  <!-- Tell the browser to be responsive to screen width -->
  <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
  <!-- Bootstrap 3.3.7 -->
  <link rel="stylesheet" href="/assets/app/bower_components/bootstrap/dist/css/bootstrap.min.css">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="/assets/app/bower_components/font-awesome/css/font-awesome.min.css">
  <!-- Ionicons -->
  <link rel="stylesheet" href="/assets/app/bower_components/Ionicons/css/ionicons.min.css">
  <!-- Theme style -->
  <link rel="stylesheet" href="/assets/app/bower_components/admin-lte/dist/css/AdminLTE.min.css">
  <!-- iCheck -->
  <link rel="stylesheet" href="/assets/app/bower_components/admin-lte/plugins/iCheck/square/blue.css">

  <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
  <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
  <!--[if lt IE 9]>
  <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
  <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
  <![endif]-->

  <!-- Google Font -->
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic">
</head>

<body class="hold-transition login-page">
  <div class="login-box">
    <div class="login-logo">
      <a href="/app"><b><%- pageTitle %></b></a>
    </div>
    <!-- /.login-logo -->
    <div class="login-box-body">
      <p class="login-box-msg">Faça o login para iniciar a sua sessão.</p>

      <form id="loginForm" method="post">
        <div class="alert" id="formMessages" style="display: none;"></div>

        <div class="form-group has-feedback">
          <input type="email" class="form-control" id="inputEmail" placeholder="E-mail">
          <span class="glyphicon glyphicon-envelope form-control-feedback"></span>
          <small class="help-block" id="emailError"></small>
        </div>

        <div class="form-group has-feedback">
          <input type="password" class="form-control" id="inputPassword" placeholder="Senha">
          <span class="glyphicon glyphicon-lock form-control-feedback"></span>
          <small class="help-block" id="passwordError"></small>
        </div>

        <div class="row">
          <div class="col-xs-4">
            <button type="submit" class="btn btn-primary btn-block btn-flat" id="submitButton">
              Entrar
            </button>
          </div>
          <div class="col-xs-8 text-right" style="padding-top: 6px;">
            <a href="/app/forgot-password">Esqueci a senha</a>
          </div>
          <!-- /.col -->
        </div>
      </form>

    </div>
    <!-- /.login-box-body -->

  </div>
  <!-- /.login-box -->

  <!-- jQuery 3 -->
  <script src="/assets/app/bower_components/jquery/dist/jquery.min.js"></script>
  <!-- Bootstrap 3.3.7 -->
  <script src="/assets/app/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
  <!-- iCheck -->
  <script src="/assets/app/bower_components/admin-lte/plugins/iCheck/icheck.min.js"></script>

  <script>
  $(function() {
    const $form = $('#loginForm');
    const $submitButton = $('#submitButton');
    const $formMessages = $('#formMessages');

    function showError(messages, isError = true) {
      $formMessages
        .removeClass('alert-danger alert-success')
        .addClass(isError ? 'alert-danger' : 'alert-success')
        .html(Array.isArray(messages) ? messages.join('<br>') : messages)
        .show();
    }

    function clearErrors() {
      $('.help-block').html('');
      $('.form-group').removeClass('has-error');
      $formMessages.hide();
    }

    function setFieldError(fieldName, message) {
      const $errorElement = $(`#${fieldName}Error`);
      if ($errorElement.length) {
        $errorElement
          .html(message)
          .closest('.form-group')
          .addClass('has-error');
      }
    }

    function validateForm(formData) {
      let hasError = false;
      clearErrors();

      // Validação do email
      if (!formData.email.trim()) {
        setFieldError('email', 'O campo e-mail é obrigatório.');
        hasError = true;
      }

      // Validação da senha
      if (!formData.password.trim()) {
        setFieldError('password', 'O campo senha é obrigatório.');
        hasError = true;
      }

      if (hasError) {
        showError('Verifique todos os campos.');
      }

      return !hasError;
    }

    $form.submit(function(e) {
      e.preventDefault();
      
      const formData = {
        email: $('#inputEmail').val(),
        password: $('#inputPassword').val()
      };

      if (!validateForm(formData)) {
        return false;
      }

      $submitButton.prop('disabled', true).html('Entrando...');

      $.ajax({
        url: '/app/login',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(formData),
        success: function(response) {
          if (response.error) {
            showError(response.messages);
          } else {
            showError('Login realizado com sucesso!', false);
            
            // Redireciona após 1 segundo
            setTimeout(function() {
              window.location.href = '/app';
            }, 1000);
          }
        },
        error: function(xhr) {
          console.error('Erro ao fazer login:', xhr);
          let errorMessage = 'Ocorreu um erro ao tentar fazer login. Tente novamente mais tarde.';
          
          if (xhr.responseJSON && xhr.responseJSON.messages) {
            errorMessage = xhr.responseJSON.messages;
          }
          
          showError(errorMessage);
        },
        complete: function() {
          $submitButton.prop('disabled', false).html('Entrar');
        }
      });

      return false;
    });
  });
  </script>
</body>

</html>