<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title><%- pageTitle %> - Login</title>
  <!-- Tell the browser to be responsive to screen width -->
  <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
  <!-- Bootstrap 3.3.7 -->
  <link rel="stylesheet" href="/assets/app/bower_components/bootstrap/dist/css/bootstrap.min.css">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="/assets/app/bower_components/font-awesome/css/font-awesome.min.css">
  <!-- Ionicons -->
  <link rel="stylesheet" href="/assets/app/bower_components/Ionicons/css/ionicons.min.css">
  <!-- Theme style -->
  <link rel="stylesheet" href="/assets/app/bower_components/admin-lte/dist/css/AdminLTE.min.css">
  <!-- iCheck -->
  <link rel="stylesheet" href="/assets/app/bower_components/admin-lte/plugins/iCheck/square/blue.css">

  <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
  <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
  <!--[if lt IE 9]>
  <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
  <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
  <![endif]-->

  <!-- Google Font -->
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic">
</head>

<body class="hold-transition login-page">
  <div class="login-box" id="AppVue">
    <div class="login-logo">
      <a href="/app"><b><%- pageTitle %></b></a>
    </div>
    <!-- /.login-logo -->
    <div class="login-box-body">
      <p class="login-box-msg">Faça o login para iniciar a sua sessão.</p>
      <p class="login-box-msg">Use o email "admin@projetosfm.com.br" e a senha "admin123".</p>

      <form @submit.prevent="doLogin()">
        <div class="alert" v-if="form.messages.length" :class="{
          'alert-danger': form.error,
          'alert-success': !form.error
        }" v-html="form.messages.join('<br>')"></div>

        <div class="form-group has-feedback" :class="{
          'has-error': form.form.email.error
        }">
          <input type="email" class="form-control" placeholder="E-mail" v-model="form.form.email.value"
            :disabled="form.loading">
          <span class="glyphicon glyphicon-envelope form-control-feedback"></span>
          <small class="help-block" v-html="form.form.email.messages.join('<br>')"></small>
        </div>

        <div class="form-group has-feedback" :class="{
          'has-error': form.form.password.error
        }">
          <input type="password" class="form-control" placeholder="Senha" v-model="form.form.password.value"
            :disabled="form.loading">
          <span class="glyphicon glyphicon-lock form-control-feedback"></span>
          <small class="help-block" v-html="form.form.password.messages.join('<br>')"></small>
        </div>

        <div class="row">
          <div class="col-xs-4">
            <button type="submit" class="btn btn-primary btn-block btn-flat" :disabled="form.loading">
              <span v-if="!form.loading">Entrar</span>
              <span v-if="form.loading">Entrando...</span>
            </button>
          </div>
          <div class="col-xs-8 text-right" style="padding-top: 6px;">
            <a href="/app/forgot-password">Esqueci a senha</a>
          </div>
          <!-- /.col -->
        </div>
      </form>

    </div>
    <!-- /.login-box-body -->

  </div>
  <!-- /.login-box -->

  <!-- jQuery 3 -->
  <script src="/assets/app/bower_components/jquery/dist/jquery.min.js"></script>
  <!-- Bootstrap 3.3.7 -->
  <script src="/assets/app/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
  <!-- iCheck -->
  <script src="/assets/app/bower_components/admin-lte/plugins/iCheck/icheck.min.js"></script>
  <!-- Vuejs CDN -->
  <script src="https://cdn.jsdelivr.net/npm/vue@2.7.14/dist/vue.min.js"></script>
  <!-- Axios CDN -->
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script>
    function isJsonDefault(str) {
      return typeof str === 'object' && typeof str.code !== 'undefined'
    }

    async function doLogin(email, password) {
      try {
        const response = await axios.post('/app/login', {
          email,
          password
        })
        return response.data
      } catch (error) {
        if (error.response && error.response.data) {
          return error.response.data
        }
        return {
          error: true,
          messages: ['Erro ao conectar com o servidor. Tente novamente mais tarde.']
        }
      }
    }

    var App = new Vue({
      el: '#AppVue',
      data: {
        form: {
          loading: false,
          error: false,
          messages: [],
          form: {
            email: {
              value: '',
              error: false,
              messages: [],
            },
            password: {
              value: '',
              error: false,
              messages: [],
            }
          }
        }
      },
      methods: {
        doLogin: async function() {
          this.form.error = false
          this.form.messages = []

          this.form.form.email.value = this.form.form.email.value.trim()
          this.form.form.email.error = false
          this.form.form.email.messages = []

          this.form.form.password.value = this.form.form.password.value.trim()
          this.form.form.password.error = false
          this.form.form.password.messages = []

          if (!this.form.form.email.value) {
            this.form.error = true
            this.form.form.email.error = true
            this.form.form.email.messages.push('O campo e-mail é obrigatório.')
          }

          if (!this.form.form.password.value) {
            this.form.error = true
            this.form.form.password.error = true
            this.form.form.password.messages.push('O campo senha é obrigatório.')
          }

          if (this.form.error) {
            this.form.messages.push('Verifique todos os campos.')
            return
          }

          this.form.loading = true

          try {
            const response = await doLogin(this.form.form.email.value, this.form.form.password.value)

            if (response.error) {
              this.form.error = response.error
              this.form.messages = response.messages || []
            } else {
              this.form.messages = ['Login realizado com sucesso!']
              setTimeout(() => {
                window.location.href = '/app'
              }, 1000)
            }
          } catch (error) {
            console.error('Erro ao fazer login:', error)
            this.form.error = true
            this.form.messages.push('Ocorreu um erro ao tentar fazer login. Tente novamente mais tarde.')
          }

          this.form.loading = false
        }
      }
    })

    setTimeout(() => {
      App.form.form.email.value = 'admin@projetosfm.com.br'
      App.form.form.password.value = 'admin123'
      // App.doLogin()
    }, 500)
  </script>
</body>

</html>