<%- contentFor('body') %>

<!-- Content Header (Page header) -->
<section class="content-header">
  <h1>
    <i class="fa fa-sitemap"></i> <%- __('app.tenants.Inquilinos') %>
  </h1>
  <ol class="breadcrumb">
    <li><a href="/app"><i class="fa fa-home"></i> <%- __('app.home.Início') %></a></li>
    <li class="active"><i class="fa fa-sitemap"></i> <%- __('app.tenants.Inquilinos') %></li>
  </ol>
</section>

<!-- Main content -->
<section class="content">

  <p class="text-right">
    <button class="btn btn-primary" @click="App.openNewTenantModal()">
      <i class="fa fa-plus"></i> <%- __('app.tenant.Criar Inquilino') %>
    </button>
  </p>

  <div class="box">
    <div class="box-header">
      <h3 class="box-title"><%- __('app.tenants.Lista de Inquilinos') %></h3>
    </div>
    <datatables :model="tenants"></datatables>
  </div>

</section>
<!-- /.content -->

<!-- Tenant Add Modal -->
<div class="modal fade" id="newTenantModal" tabindex="-1" role="dialog" aria-labelledby="newTenantModalLabel">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span
            aria-hidden="true">&times;</span></button>

        <h4 class="modal-title" v-if="!tenant.fields.uuid.value"><%- __('app.tenant.Criar Inquilino') %></h4>
        <h4 class="modal-title" v-else><%- __('app.tenant.Editar Inquilino') %></h4>
      </div>

      <div class="modal-body">

        <form id="newTenantForm" @submit.prevent="App.saveTenant()">

          <div class="alert" v-if="tenant.messages.length" :class="{'alert-danger': tenant.error, 'alert-success': !tenant.error}">
            <p v-for="message in tenant.messages">{{ message }}</p>
          </div>

          <div class="form-group" :class="{'has-error': tenant.fields.name.error}">
            <label for="name"><%- __('app.tenant.Nome') %></label>
            <input type="text" class="form-control" v-model="tenant.fields.name.value" :disabled="tenant.loading">
            <small class="help-block" v-if="tenant.fields.name.error" v-html="tenant.fields.name.messages.join('<br>')"></small>
          </div>

          <div class="form-group" :class="{'has-error': tenant.fields.description.error}">
            <label for="description"><%- __('app.tenant.Descrição') %></label>
            <textarea name="description" id="description" class="form-control" rows="3" v-model="tenant.fields.description.value" :disabled="tenant.loading"></textarea>
            <small class="help-block" v-if="tenant.fields.description.error" v-html="tenant.fields.description.messages.join('<br>')"></small>
          </div>

          <div class="row">
            <div class="col-md-4">
              <div class="form-group" :class="{'has-error': tenant.fields.appTitle.error}">
                <label for="appTitle"><%- __('app.tenant.Título') %></label>
                <input type="text" class="form-control" v-model="tenant.fields.appTitle.value" :disabled="tenant.loading">
                <small class="help-block" v-if="tenant.fields.appTitle.error" v-html="tenant.fields.appTitle.messages.join('<br>')"></small>
              </div>
            </div>
            <!-- end::col -->

            <div class="col-md-4">
              <div class="form-group" :class="{'has-error': tenant.fields.appShortTitle.error}">
                <label for="appShortTitle"><%- __('app.tenant.Título curto') %></label>
                <input type="text" class="form-control" v-model="tenant.fields.appShortTitle.value" :disabled="tenant.loading">
                <small class="help-block" v-if="tenant.fields.appShortTitle.error" v-html="tenant.fields.appShortTitle.messages.join('<br>')"></small>
              </div>
            </div>
            <!-- end::col -->

            <div class="col-md-4">
              <div class="form-group" :class="{'has-error': tenant.fields.active.error}">
                <label for="active"><%- __('app.tenant.Ativo') %></label>
                <select name="active" id="active" class="form-control" v-model="tenant.fields.active.value" :disabled="tenant.loading || !tenant.fields.uuid.value">
                  <option value=""><%- __('app.tenant.Selecione') %></option>
                  <option value="1"><%- __('app.tenant.Ativo') %></option>
                  <option value="0"><%- __('app.tenant.Inativo') %></option>
                </select>
                <small class="help-block" v-if="tenant.fields.active.error" v-html="tenant.fields.active.messages.join('<br>')"></small>
              </div>
            </div>
            <!-- end::col -->
          </div>
          <!-- end::row -->

        </form>

      </div>

      <div class="modal-footer">
        <p v-if="!tenant.delete">
          <button type="submit" class="btn btn-primary" form="newTenantForm" v-if="!tenant.fields.uuid.value" :disabled="tenant.loading">
            <span class="fa fa-save"></span>
            <%- __('app.tenant.Criar') %>
          </button>

          <button type="submit" class="btn btn-primary" form="newTenantForm" v-else :disabled="tenant.loading">
            <span class="fa fa-save"></span>
            <%- __('app.tenant.Atualizar') %>
          </button>

          <button type="button" class="btn btn-danger" :disabled="tenant.loading || !tenant.fields.uuid.value" @click="App.tenant.delete = true">
            <span class="fa fa-trash"></span>
            <%- __('app.tenant.Apagar') %>
          </button>

          <button type="button" class="btn btn-default" data-dismiss="modal"data-dismiss="modal" @click="App.cancelTenant()" :disabled="tenant.loading">
            <span class="fa fa-times"></span>
            <%- __('app.tenant.Cancelar') %>
          </button>
        </p>

        <p v-if="tenant.delete">
          <span class="text-danger"><%- __('app.tenant.Deseja realmente apagar este inquilino?') %></span>

          <button type="button" class="btn btn-danger" :disabled="tenant.loading" @click="App.deleteTenant()">
            <span class="fa fa-check"></span>
            <%- __('app.tenant.Sim, apagar') %>
          </button>

          <button type="button" class="btn btn-default" @click="App.tenant.delete = false">
            <span class="fa fa-times"></span>
            <%- __('app.tenant.Não, cancelar') %>
          </button>

        </p>
      </div>
    </div>
  </div>
</div>
<!-- /Tenant Add Modal -->

<%- contentFor('scripts') %>

<script>
  mixins.push({
    data: {
      tenants: {
        loading: false,
        loaded: false,
        list: [],
        meta: {
          totalCount: 0,
          filteredCount: 0,
          start: 0,
          length: 10,
          pages: 0,
          currentPage: 0,
          orderBy: {
            column: 'name',
            dir: "ASC"
          }
        },
        initialOptions: {
          start: 0,
          length: 10,
          orderByColumn: 'name',
          orderByDir: 'ASC',
        },
        columns: [
          {
            label: "<%- __('app.tenant.Nome')%>",
            field: 'name',
            minWidth: 200,
            sortable: true,
            html: true,
            render: (value, row) => {
              return `
                <a href="#" onclick="App.tenantSelect(event, '${row.uuid}');">
                  ${row.name}
                </a>
              `
            }
          },
          {
            label: "<%- __('app.tenant.Descrição')%>",
            field: 'description',
            sortable: false,
          },
          {
            label: "<%- __('app.tenant.Título')%>",
            field: 'appTitle',
            sortable: false,
            width: 200,
          },
          {
            label: "<%- __('app.tenant.Título curto')%>",
            field: 'appShortTitle',
            sortable: false,
            width: 200,
          },
          {
            label: "<%- __('app.tenant.Criado em')%>",
            field: 'createdAt',
            sortable: true,
            width: 200,
            align: 'center',
            nowrap: true,
            html: true,
            render: (value, row) => {
              return datimeFormatDefault(row.createdAt, 'DD/MM/YYYY HH:mm:ss')
            }
          },
          {
            label: "<%- __('app.tenant.Ativo')%>",
            field: 'active',
            sortable: true,
            width: 100,
            align: 'center',
            nowrap: true,
            html: true,
            render: (value, row) => {
              return row.active
                ? "<span class='label label-success'><%- __('app.tenant.Ativo') %></span>"
                : "<span class='label label-danger'><%- __('app.tenant.Inativo') %></span>"
            }
          },
          // {
          //   label: 'Ações',
          //   sortable: false,
          //   width: 120,
          //   nowrap: true,
          //   html: true,
          //   buttons: [
          //     {
          //       label: '<span class="fa fa-pencil"></span>',
          //       class: 'btn btn-outline-default btn-sm btn-flat',
          //       click: (row) => window.location.href = `/app/clients/${row._id}`
          //     },
          //     {
          //       label: '<span class="fa fa-trash"></span>',
          //       class: 'btn btn-outline-danger btn-sm btn-flat',
          //       click: (row) => App.deleteClient(row._id)
          //     }
          //   ]
          // },
        ],
        getList: () => {
          App.getTenants()
        },
      },

      tenant: {
        loading: false,
        error: false,
        messages: [],
        delete: false,
        fields: {
          uuid: {
            error: false,
            messages: [],
            value: ''
          },
          name: {
            error: false,
            messages: [],
            value: ''
          },
          description: {
            error: false,
            messages: [],
            value: ''
          },
          appTitle: {
            error: false,
            messages: [],
            value: ''
          },
          appShortTitle: {
            error: false,
            messages: [],
            value: ''
          },
          active: {
            error: false,
            messages: [],
            value: ''
          },

        }
      }

    },
    methods: {
      init: () => {
        App.getTenants()

        // setTimeout(() => {
        //   App.tenant.fields.name.value = 'Nome do teste 1'
        //   App.tenant.fields.description.value = 'Descrição do teste 1'
        //   App.tenant.fields.appTitle.value = 'Teste 1'
        //   App.tenant.fields.appShortTitle.value = 'TT1'
        //   App.saveTenant()

        //   setTimeout(() => {
        //     App.tenant.fields.name.value = 'Nome do teste 2'
        //     App.tenant.fields.description.value = 'Descrição do teste 2'
        //     App.tenant.fields.appTitle.value = 'Teste 2'
        //     App.tenant.fields.appShortTitle.value = 'TT2'
        //     App.saveTenant()
        //   }, 1500)
        // }, 1500)

        // setTimeout(() => {
        //   App.tenantSelect(null, '099e49fc-6050-11f0-a360-52fbe6087460')

        //   setTimeout(() => {
        //     App.tenant.delete = true

        //     setTimeout(() => {
        //       App.deleteTenant()
        //     }, 500)
        //   }, 500)
        // }, 500)
      },

      getTenants: async () => {
        doLog('getTenants()')

        try {
          const options = Object.assign(App.tenants.initialOptions)

          App.tenants.loading = true

          const response = (await axios({
            method: 'get',
            url: '/api/v1/tenants',
            params: options,
          })).data

          App.tenants.meta = response.content.meta
          App.tenants.list = response.content.data

          App.tenants.loading = false
          App.tenants.loaded = true
        } catch (error) {
          doLog("getTenants() error", error)
          notify('<%- __("app.error.Ocorreu um erro interno. Por favor tenta novamente") %>', 'danger')
        }

      },

      tenantSelect: (event, uuid) => {
        doLog('tenantSelect()', uuid)

        if (event) event.preventDefault()

        // Vamos buscar o projeto
        const tenant = App.tenants.list.find(tenant => tenant.uuid === uuid)

        if (!tenant) {
          return
        }

        App.tenant.delete = false

        // Vamos preencher o formulario
        App.tenant.fields.uuid.value = tenant.uuid
        App.tenant.fields.name.value = tenant.name
        App.tenant.fields.description.value = tenant.description
        App.tenant.fields.appTitle.value = tenant.appTitle
        App.tenant.fields.appShortTitle.value = tenant.appShortTitle
        App.tenant.fields.active.value = tenant.active

        App.openNewTenantModal()
      },

      cancelTenant: () => {
        doLog('cancelTenant()')

        clearFormErrors(App.tenant)

        App.tenant.fields.uuid.value = ''
        App.tenant.fields.name.value = ''
        App.tenant.fields.description.value = ''
        App.tenant.fields.appTitle.value = ''
        App.tenant.fields.appShortTitle.value = ''
        App.tenant.fields.active.value = ''
      },

      saveTenant: async () => {
        doLog('saveTenant()')

        clearFormErrors(App.tenant)

        let error = false

        if (!App.tenant.fields.name.value) {
          App.tenant.fields.name.error = true
          App.tenant.fields.name.messages.push("<%- __('validator.Campo obrigatório.') %>")
          error = true
        }

        if (error) {
          App.tenant.error = true
          App.tenant.messages.push("<%- __('validator.Verifique todos os campos.') %>")
          return
        }

        try {
          App.tenant.loading = true

          let uuid = App.tenant.fields.uuid.value

          let response = null

          if (!uuid) {
            response = (await axios({
              method: 'post',
              url: '/api/v1/tenants',
              data: {
                name: App.tenant.fields.name.value,
                description: App.tenant.fields.description.value,
                appTitle: App.tenant.fields.appTitle.value,
                appShortTitle: App.tenant.fields.appShortTitle.value
              }
            })).data

            uuid = response.content.data.uuid
          } else {
            response = (await axios({
              method: 'put',
              url: `/api/v1/tenants/${uuid}`,
              data: {
                name: App.tenant.fields.name.value,
                description: App.tenant.fields.description.value,
                appTitle: App.tenant.fields.appTitle.value,
                appShortTitle: App.tenant.fields.appShortTitle.value,
                active: App.tenant.fields.active.value
              }
            })).data
          }
          formPopulate(App.tenant, response)

          await App.getTenants()

          App.tenantSelect(null, uuid)
        } catch (error) {
          doLog("saveTenant() error", error)

          if (isAxiosError(error) && isApiError(error)) {
            const response = error.response.data
            formPopulate(App.tenant, response)
          } else {
            notify('<%- __("app.error.Ocorreu um erro interno. Por favor tenta novamente") %>', 'danger')
          }
        } finally {
          App.tenant.loading = false
        }
      },

      deleteTenant: async () => {
        doLog('deleteTenant()')

        try {
          App.tenant.loading = true

          const response = (await axios({
            method: 'delete',
            url: `/api/v1/tenants/${App.tenant.fields.uuid.value}`
          })).data

          formPopulate(App.tenant, response)

          App.cancelTenant()
          App.closeNewTenantModal()

          await App.getTenants()

          notify('<%- __("app.tenant.Inquilino apagado com sucesso.") %>', 'success')
        } catch (error) {
          doLog("deleteTenant() error", error)

          if (isAxiosError(error) && isApiError(error)) {
            const response = error.response.data
            formPopulate(App.tenant, response)
          } else {
            notify('<%- __("app.error.Ocorreu um erro interno. Por favor tenta novamente") %>', 'danger')
          }
        } finally {
          App.tenant.loading = false
        }
      },

      openNewTenantModal: () => {
        $('#newTenantModal').modal('show')
      },

      closeNewTenantModal: () => {
        $('#newTenantModal').modal('hide')
      },
    }
  })
</script>