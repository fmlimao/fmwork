<%- contentFor('body') %>

<!-- Content Header (Page header) -->
<section class="content-header">
  <h1>
    <i class="fa fa-sitemap"></i> Papéis - Cadastrar
  </h1>
  <ol class="breadcrumb">
    <li><a href="/app"><i class="fa fa-home"></i> Início</a></li>
    <li><a href="/app/tenants/<%= tenantUuid %>"><i class="fa fa-sitemap"></i> Inquilino</a></li>
    <li>Papéis</li>
    <li class="active"><i class="fa fa-plus"></i> Cadastrar</li>
  </ol>
</section>

<!-- Main content -->
<section class="content">

  <p>
    <a href="/app/tenants/<%= tenantUuid %>" class="btn btn-default">
      <i class="fa fa-arrow-left"></i> Voltar
    </a>
  </p>

  <!-- Alert loading -->
  <div v-if="role.loading && !role.loaded">
    <div class="alert alert-info">
      <i class="fa fa-spinner fa-spin"></i> Carregando...
    </div>
  </div>
  <!-- end::Alert loading -->

  <!-- Alert no records -->
  <div v-if="role.loaded">
    <form id="newRoleForm" @submit.prevent="App.saveRole()">

      <div class="box box-primary">
        <div class="box-header with-border">
          <h3 class="box-title">Cadastrar Inquilino</h3>
        </div>
        <!-- end::box-header -->

        <div class="box-body">

          <div class="alert" v-if="role.messages.length" :class="{'alert-danger': role.error, 'alert-success': !role.error}">
            <p v-for="message in role.messages">{{ message }}</p>
          </div>

          <div class="form-group" :class="{'has-error': role.fields.name.error}">
            <label for="name">Nome</label>
            <input type="text" class="form-control" v-model="role.fields.name.value" :disabled="role.loading">
            <small class="help-block" v-if="role.fields.name.error" v-html="role.fields.name.messages.join('<br>')"></small>
          </div>

          <div class="form-group" :class="{'has-error': role.fields.description.error}">
            <label for="description">Descrição</label>
            <textarea name="description" id="description" class="form-control" rows="3" v-model="role.fields.description.value" :disabled="role.loading"></textarea>
            <small class="help-block" v-if="role.fields.description.error" v-html="role.fields.description.messages.join('<br>')"></small>
          </div>

        </div>
        <!-- end::box-body -->

        <div class="box-footer">

          <button type="submit" class="btn btn-primary" form="newRoleForm" :disabled="role.loading">
            <span class="fa fa-save"></span>
            Criar
          </button>

        </div>
        <!-- end::box-footer -->
      </div>
      <!-- end::box -->

    </form>
  </div>
  <!-- end::Alert no records -->

</section>
<!-- /.content -->

<%- contentFor('scripts') %>
<script>
  const tenantUuid = '<%= tenantUuid %>'
</script>
<script src="/assets/app/js/pages/tenants/roles/create.js?_v=<%= assetsVersion %>"></script>