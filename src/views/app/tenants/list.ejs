<!-- Content Header (Page header) -->
<section class="content-header">
  <h1>
    <i class="fa fa-building"></i> Inquilinos
    <small>Lista de inquilinos</small>
  </h1>
  <ol class="breadcrumb">
    <li><a href="/app"><i class="fa fa-dashboard"></i> Home</a></li>
    <li class="active">Inquilinos</li>
  </ol>
</section>

<!-- Main content -->
<section class="content">
  <div class="row">
    <div class="col-xs-12">
      <div class="box">
        <div class="box-header">
          <h3 class="box-title">Lista de Inquilinos</h3>
          <div class="box-tools">
            <a href="/app/tenants/create" class="btn btn-primary btn-sm">
              <i class="fa fa-plus"></i> Novo Inquilino
            </a>
          </div>
        </div>
        <!-- /.box-header -->
        <div class="box-body table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Nome</th>
                <th>Domínio</th>
                <th>Status</th>
                <th width="120">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% if (tenants.length === 0) { %>
                <tr>
                  <td colspan="4" class="text-center">Nenhum inquilino cadastrado</td>
                </tr>
              <% } %>
              
              <% tenants.forEach(function(tenant) { %>
                <tr>
                  <td><%- tenant.name %></td>
                  <td><%- tenant.domain %></td>
                  <td>
                    <% if (tenant.active) { %>
                      <span class="label label-success">Ativo</span>
                    <% } else { %>
                      <span class="label label-danger">Inativo</span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/app/tenants/<%- tenant.tenant_id %>/edit" class="btn btn-primary btn-xs" title="Editar">
                      <i class="fa fa-pencil"></i>
                    </a>
                    <button type="button" class="btn btn-danger btn-xs btn-delete" data-id="<%- tenant.tenant_id %>" title="Excluir">
                      <i class="fa fa-trash"></i>
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <!-- /.box-body -->
      </div>
      <!-- /.box -->
    </div>
  </div>
</section>

<!-- Modal de confirmação de exclusão -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
          <span aria-hidden="true">&times;</span>
        </button>
        <h4 class="modal-title">Confirmar Exclusão</h4>
      </div>
      <div class="modal-body">
        <p>Tem certeza que deseja excluir este inquilino?</p>
        <p class="text-danger">
          <strong>Atenção:</strong> Esta ação não poderá ser desfeita.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" id="confirmDelete">Excluir</button>
      </div>
    </div>
  </div>
</div>

<script>
$(function() {
  let tenantIdToDelete = null;
  
  // Abre o modal de confirmação
  $('.btn-delete').click(function() {
    tenantIdToDelete = $(this).data('id');
    $('#deleteModal').modal('show');
  });
  
  // Confirma a exclusão
  $('#confirmDelete').click(function() {
    if (!tenantIdToDelete) return;
    
    $.ajax({
      url: '/app/tenants/' + tenantIdToDelete,
      method: 'DELETE',
      success: function(response) {
        if (response.error) {
          alert(response.messages.join('\n'));
        } else {
          window.location.reload();
        }
      },
      error: function(xhr) {
        console.error('Erro ao excluir inquilino:', xhr);
        alert('Ocorreu um erro ao tentar excluir o inquilino. Tente novamente mais tarde.');
      }
    });
  });
});</script> 